# Public Supabase browser configuration.
# Copy to .env for local development and provide real values outside Git.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase credential.
# Never commit a real value and never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional shared database-backed rate limits for the public assistant and
# investor inquiry form. Keep false until the reviewed Supabase migration has
# been applied and verified on the matching project.
SOMMAN_SHARED_QUOTA_ENABLED=false

# Server-only Lovable AI gateway credential used by the quarry assistant.
# Never expose this with a VITE_ prefix.
LOVABLE_API_KEY=your-server-only-lovable-api-key
